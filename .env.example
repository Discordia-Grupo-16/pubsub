# Conexión al broker. En local alcanza con el host: RabbitMQ usa guest/guest
# por defecto. En cualquier otro entorno la URL trae credenciales y sale del
# sistema de secretos, nunca del repositorio.
RABBITMQ_URL=amqp://localhost:5672/

# Nombre del servicio que usa el cliente (identity, community, chat, ...).
# Identifica la conexión en la management UI y prefija las colas.
SERVICE_NAME=

# Topic exchange de eventos de dominio y su dead-letter exchange.
RABBITMQ_EXCHANGE=discordia.events
RABBITMQ_DEAD_LETTER_EXCHANGE=discordia.events.dlx

# Mensajes sin ackear que el broker le entrega a cada consumer.
PUBSUB_PREFETCH=16

# Reintentos en proceso ante un fallo transitorio, antes de la DLQ.
PUBSUB_MAX_RETRIES=3
PUBSUB_RETRY_INITIAL_DELAY=200ms
PUBSUB_RETRY_MAX_DELAY=5s

# Espera de la confirmación del broker al publicar.
PUBSUB_PUBLISH_TIMEOUT=5s

# Backoff de reconexión cuando se cae el broker.
PUBSUB_RECONNECT_INITIAL_DELAY=500ms
PUBSUB_RECONNECT_MAX_DELAY=30s
